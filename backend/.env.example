# SMTP server settings for workflow and failure-notification emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
# Comma-separated exact public HTTPS API hostnames allowed for HTTP steps.
HTTP_ALLOWED_HOSTS=
# Existing absolute folder that file workflow steps may access.
WORKFLOW_FILE_ROOT=
# Automatically resume interrupted executions at startup (false, true, 1, or yes).
AUTO_RESUME_ON_START=false
# Delay in seconds between failed step attempts (0 to 10).
RETRY_DELAY_SECONDS=1
# Optional email address to notify when a workflow execution fails.
NOTIFY_EMAIL_ON_FAILURE=
